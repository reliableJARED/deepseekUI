# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is git-ignored; never commit a real key.
#
# Anything here can also be set as a real environment variable, which takes
# precedence for the shell it is set in.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Credentials
# ─────────────────────────────────────────────────────────────────────────────

# Required. Get one at https://platform.deepseek.com/api_keys
# Referenced by providers.json as ${DEEPSEEK_API_KEY}, so the key never has to
# be written into a file that might be shared or committed.
DEEPSEEK_API_KEY=MY_DEEPSEEK_API_KEY


# ─────────────────────────────────────────────────────────────────────────────
# Model
#
# Model definitions live in providers.json, not here — only the *default* is set
# in the environment. Blank means "whatever providers.json lists first".
# ─────────────────────────────────────────────────────────────────────────────

#   deepseek-flash    - DeepSeek-V4.1-Flash. Tool calls AND vision.
#   deepseek-v4-pro   - DeepSeek-V4-Pro. Tool calls, NO vision.
#
# Both accept 1,000,000 input tokens and emit up to 393,216.
DEEPSEEK_MODEL=deepseek-flash

# ─────────────────────────────────────────────────────────────────────────────
# Local server
# ─────────────────────────────────────────────────────────────────────────────

HOST=127.0.0.1
PORT=5000

# Bind to every interface (0.0.0.0). Keep false.
# WARNING: your API key lives in this process. Exposing the port lets anyone on
# the network spend your credits. `run.py` refuses a non-loopback bind unless
# this is true AND --lan is passed.
ALLOW_LAN=false

# ─────────────────────────────────────────────────────────────────────────────
# Paths. Relative paths resolve against the project directory.
# ─────────────────────────────────────────────────────────────────────────────

# Where conversations and their media are written. One directory per
# conversation: conversation.json plus every image, video and frame it owns.
MEDIA_ROOT=./memory

PROVIDERS_PATH=./providers.json
ENV_FILE=./.env
FRONTEND_DIR=./frontend/dist

# MCP servers over Streamable HTTP. Absent or empty means MCP is off. The file it
# points at is git-ignored (it holds API keys in plain text) and is created from
# mcp.example.json, next to it, the first time the app or either mcp_server/ starts.
MCP_CONFIG=./mcp.json

# Extra directories the `display_media` tool may read from, so the model can show
# you a picture, clip or sound that a tool put outside the conversation. The
# project directory is always readable; this adds to it. Separated by `;` — not
# `:` — because a drive letter contains a colon. The media directory (MEDIA_ROOT)
# is always refused, since it holds every conversation's files at once.
# Leave empty to keep it to the project directory only.
# MEDIA_DISPLAY_ROOTS=./mcp_server/web_media;C:\Users\me\Pictures
MEDIA_DISPLAY_ROOTS=

# ─────────────────────────────────────────────────────────────────────────────
# Context and media budget
# ─────────────────────────────────────────────────────────────────────────────

# Longest edge, in pixels, for images sent TO THE MODEL.
# The API downscales to about 1300x1300 regardless, which costs up to ~1024
# tokens. Sending much more wastes upload bandwidth; sending much less throws
# away detail. Note the API also *upscales* images below ~544 px, so tiny images
# cost nearly the same as large ones.
MODEL_IMAGE_MAX_DIM=1280

# Video is sampled into stills, because a video cannot be sent as video.
# 1 fps x 16 frames is a reasonable ceiling: each frame costs up to ~1024 tokens,
# so 16 frames is already ~16k tokens of budget for a single clip.
MODEL_VIDEO_MAX_DIM=512
MODEL_VIDEO_FPS=1
MODEL_VIDEO_MAX_FRAMES=16

# Maximum images in a single request. Past 15 images the API lowers its
# per-side limit from 8192 px to 4096 px, so larger counts are riskier.
MODEL_MAX_IMAGES=600

# Ceiling on rehydrated media per request, in characters of base64. The API's
# body limit is 48 MiB and base64 inflates by roughly a third.
MEDIA_CHAR_BUDGET=6000000

# Fraction of the context window that may be filled before the oldest turns are
# dropped to make room. Lower means more aggressive trimming.
CONTEXT_SAFETY_RATIO=0.92

# ─────────────────────────────────────────────────────────────────────────────
# Tool loop
# ─────────────────────────────────────────────────────────────────────────────

# Maximum tool calls in one turn. Each step is a full round trip to the API, and
# every step re-sends the whole conversation, so this is also a cost control.
# Editable from the Settings drawer in the UI, which writes this line back here.
MAX_TOOL_STEPS=8

# Timeout for a single upstream request, in seconds.
REQUEST_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────────
# Remote media — YouTube links, and videos that live at a URL
#
# `display_media` and `reduce_video_frames` accept an `https://` URL as well as a
# path. The server does NOT download the file: it reads the metadata, decodes a
# poster and a handful of stills, and hands the original URL to the player. A
# 20-minute 1080p source costs a few megabytes of seeking, not a few gigabytes.
# ─────────────────────────────────────────────────────────────────────────────

# Total bytes one probe may pull from a remote source before it is cut off.
# This is enforced mid-stream, not checked afterwards. Deliberately far below a
# minute of 1080p H.264 (~5 MB at 8 Mbit/s): a source that needs more than this
# is being read the wrong way, and the error says so.
REMOTE_MEDIA_MAX_BYTES=25165824

# Wall-clock ceilings, in seconds: one HTTP request, the index probe that has to
# walk to the container's header, and the whole probe including every seek. The
# last one is the one that matters — a tool call that outruns its dispatcher does
# not fail here, it drops the session.
REMOTE_MEDIA_TIMEOUT=20
REMOTE_MEDIA_PROBE_TIMEOUT=45
REMOTE_MEDIA_TOTAL_TIMEOUT=90

# How many stills one video may be sampled into, and their longest edge. Eight is
# enough to say what happens in a clip; the ceiling is what stops a 20-minute film
# from turning into twelve hundred frames of token bill.
REMOTE_FRAMES_MAX=8
REMOTE_FRAME_MAX_DIM=512

# Land a local proxy in front of playback. It exists for hosts that refuse a
# browser request but accept the same request with our headers, and it is the
# thing that makes the byte ceiling above measurable. It listens on 127.0.0.1
# only, on a random port. Set false to hand the player the original URL instead.
REMOTE_MEDIA_PROXY=true

# Allow http://localhost/ and private LAN addresses. Off, because the two URLs
# this would otherwise be pointed at all day are this server itself and a local
# model daemon — and neither is a video. Local files need a path, not a URL.
REMOTE_MEDIA_ALLOW_PRIVATE=false
